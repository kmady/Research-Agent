# Copier en .env puis remplacer les valeurs. Ne jamais committer .env.
SEARXNG_SECRET=remplacer-par-openssl-rand-hex-32
RA_WEB_USER=admin
RA_WEB_PASSWORD=remplacer-par-un-mot-de-passe-long
RA_WEB_HOST=127.0.0.1
RA_MAX_QUEUE=10
RA_MODEL=qwen3:8b
# Contact public, demandé par les sites consultés (URL ou e-mail de contact).
# À remplir dans .env seulement, jamais ici : ce fichier est publié.
RA_USER_AGENT=
